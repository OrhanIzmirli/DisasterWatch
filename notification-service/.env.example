# Environment of the notification-service (Kafka consumer).
# docker-compose.yml sets all of these for the container; this file documents
# them for a cloud deployment (Render + Neon + Aiven) or a run outside Docker.

NODE_ENV=development
# Health-check HTTP port (GET /health). Hosting platforms provide PORT.
PORT=3000

# The app database: the consumer reads AlertSubscription and writes Notification.
# Required; the service exits at start-up without it.
DATABASE_URL=postgresql://postgres:postgres@disasterwatch_db:5432/disasterwatch

# Kafka broker(s), comma-separated. Local docker-compose: the service name.
KAFKA_BROKER=dw-kafka:9092

# Managed Kafka (e.g. Aiven). Leave empty for the local plaintext broker.
# When username and password are both set, the client connects with SASL_SSL.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# plain | scram-sha-256 | scram-sha-512 (default: scram-sha-256)
KAFKA_SASL_MECHANISM=
# Optional CA certificate (PEM); newlines may be written as \n.
KAFKA_SSL_CA=

# E-mail alert digests (opt-in per user on the Alerts page). E-mail stays off,
# and the Alerts page says so, unless RESEND_API_KEY, RESEND_FROM and APP_URL
# are all set. Never commit a real key.
# Resend test mode (no own domain yet): RESEND_FROM=DisasterWatch <onboarding@resend.dev>
# delivers only to the address of the Resend account owner.
RESEND_API_KEY=
RESEND_FROM=
# Public site URL for the links in the e-mail (event, alert settings, unsubscribe), no trailing slash.
APP_URL=
# Digests per rolling 24 hours (default 90; the Resend free plan allows 100 per day).
EMAIL_DAILY_LIMIT=
