generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                 @id @default(autoincrement())
  email         String              @unique
  password      String
  role          String              @default("user")
  createdAt     DateTime            @default(now())
  subscriptions AlertSubscription[]
}

/// A user's request to be alerted about disasters of a given type and
/// minimum severity within radiusKm of a point. Matching against live
/// events happens in a later release.
model AlertSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("any")
  minSeverity String   @default("low")
  label       String
  centerLat   Float
  centerLng   Float
  radiusKm    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Disaster {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  severity    String?
  magnitude   Float?
  lat         Float
  lng         Float
  date        DateTime
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
}
