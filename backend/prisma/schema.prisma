generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                 @id @default(autoincrement())
  email         String              @unique
  password      String
  role          String              @default("user")
  createdAt     DateTime            @default(now())
  lastLoginAt   DateTime?
  /// Set when an admin suspends the account; sign-in is refused and every
  /// existing session is rejected by requireAuth.
  disabledAt    DateTime?
  /// Bumped to invalidate all sessions at once (tokens carry the version).
  tokenVersion  Int                 @default(0)
  subscriptions AlertSubscription[]
  notifications Notification[]
  /// E-mail alerts are opt-in: off until the user turns them on (Alerts page).
  emailAlertsEnabled    Boolean             @default(false)
  /// When the user agreed to e-mail alerts; null while they are off. Only
  /// notifications created after this moment are e-mailed.
  emailAlertsConsentAt  DateTime?
  /// Unguessable token of the one-click unsubscribe link (no sign-in needed);
  /// created on the first opt-in and kept, so links in older e-mails keep working.
  emailUnsubscribeToken String?             @unique
  /// Double opt-in: the address is only e-mailed alerts after its owner
  /// opened the confirmation link (registration does not verify addresses).
  emailVerifiedAt       DateTime?
  /// Set when the confirmation link was opened while signed in to this account (password and
  /// mailbox proven together). Only then can an ADMIN_EMAILS address be an admin (utils/adminEmails.js).
  emailConfirmedSignedInAt DateTime?
  /// Token of the confirmation link; cleared once used.
  emailConfirmToken     String?             @unique
  /// When the notification-service queued the confirmation e-mail.
  emailConfirmSentAt    DateTime?
  emailDeliveries       EmailDelivery[]
}

/// One row per administrative action, written in the same transaction as
/// the action. targetLabel keeps a human-readable reference (masked e-mail
/// for deleted users) after the target row is gone; no relation on purpose.
model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int
  actorEmail   String
  /// user.disable | user.enable | user.delete | disaster.create
  action       String
  targetUserId Int?
  targetLabel  String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// A user's request to be alerted about disasters of a given type and
/// minimum severity within radiusKm of a point. Matching against live
/// events happens in a later release.
model AlertSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("any")
  minSeverity String   @default("low")
  label       String
  centerLat   Float
  centerLng   Float
  radiusKm    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  notifications Notification[]

  @@index([userId])
}

/// Every disaster event the backend has seen from NASA, USGS or the admin
/// console. eventId is the contract id ("nasa:EONET_1234"); inserting with
/// ON CONFLICT DO NOTHING makes ingestion idempotent and tells us which
/// events are genuinely new (only those are published to Kafka).
model IngestedEvent {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique
  source      String
  type        String
  severity    String
  title       String
  lat         Float
  lng         Float
  occurredAt  DateTime
  firstSeenAt DateTime  @default(now())
  /// Transactional outbox: null until the event has been published to Kafka.
  publishedAt DateTime?
  /// "exact" | "approximate" (the map marker's location note); null for rows
  /// recorded before the column existed. Read by the notification e-mails.
  locationPrecision String?

  @@index([publishedAt, firstSeenAt])
}

/// An in-app notification produced by the notification-service when a
/// published event matches one of the user's alert subscriptions.
model Notification {
  id             Int                @id @default(autoincrement())
  userId         Int
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId Int?
  subscription   AlertSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  eventId        String
  title          String
  type           String
  severity       String
  lat            Float
  lng            Float
  distanceKm     Float
  occurredAt     DateTime
  createdAt      DateTime           @default(now())
  readAt         DateTime?
  /// The e-mail digest this notification was put in (notification-service).
  emailDeliveryId Int?
  emailDelivery   EmailDelivery?     @relation(fields: [emailDeliveryId], references: [id], onDelete: SetNull)
  /// Set only after the e-mail provider accepted the digest.
  emailSentAt     DateTime?
  /// Why no e-mail was sent: "daily-limit" | "send-failed" | "disabled".
  emailSkipReason String?

  @@unique([userId, eventId])
  @@index([userId, readAt])
  @@index([emailDeliveryId])
  @@index([createdAt])
}

/// One e-mail digest to one user (notification-service). Created as
/// "pending" before the send, so a failed send is retried with the same
/// provider idempotency key and the daily limit is counted from here.
model EmailDelivery {
  id                Int            @id @default(autoincrement())
  /// null once the account is deleted: the row stays, anonymised, because the
  /// daily limit and the confirmation cap are counted from it (utils/accountDeletion.js)
  userId            Int?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// "digest" (alerts) | "confirm" (double opt-in link, no user-written text)
  kind              String         @default("digest")
  /// "pending" | "sent" | "failed" | "cancelled"
  status            String         @default("pending")
  notificationCount Int
  attempts          Int            @default(0)
  createdAt         DateTime       @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  /// Provider error, e-mail addresses masked.
  lastError         String?
  providerMessageId String?
  /// The rendered message { subject, text, html, headers }, stored before the
  /// first attempt so a retry sends the same payload under the same idempotency key.
  payload           Json?
  /// Short lease of the instance that is sending it (no second sender meanwhile).
  leaseUntil        DateTime?
  notifications     Notification[]

  @@index([status, createdAt])
  @@index([sentAt])
}

/// Single row (id = 1) the notification-service writes on start and after
/// every e-mail run, so the backend can tell the Alerts page whether e-mail
/// is really configured. No addresses.
model EmailChannelStatus {
  id          Int       @id
  configured  Boolean
  dailyLimit  Int
  updatedAt   DateTime
  lastSentAt  DateTime?
  lastError   String?
  lastErrorAt DateTime?
}

model Disaster {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  severity    String?
  magnitude   Float?
  lat         Float
  lng         Float
  date        DateTime
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

/// Durable copy of the GDACS lookups (services/gdacs.js): one row per GDACS
/// event, so a restarted backend (Render sleep, deploy) starts with the
/// levels and points it already knew instead of several hundred lookups.
/// Rows older than 30 days are deleted when the backend loads them.
model GdacsCache {
  /// GDACS "eventtype:eventid", e.g. "WF:1032806"
  key       String   @id
  /// "green" | "orange" | "red"; null when GDACS answered without a level
  level     String?
  score     Float?
  text      String?
  /// ISO 3166-1 alpha-2 codes of the affected countries, comma-separated ("" when none)
  countries String   @default("")
  /// GDACS event point; null when GDACS gives none
  lat       Float?
  lng       Float?
  /// When GDACS answered; the entry is refreshed 6 hours after this
  fetchedAt DateTime

  @@index([fetchedAt])
}

/// Durable copy of the news cache: one row per article of the last
/// successful refresh, so a restarted backend (Render sleep) can serve the
/// previous articles instead of 503 until GDELT answers again.
model NewsCache {
  id           Int       @id @default(autoincrement())
  url          String    @unique
  title        String
  domain       String
  image        String?
  publishedAt  DateTime?
  /// "gdelt" | "guardian" | "gdacs"
  provider     String
  relatedEvent Json?
  /// { countries: ["MX"], regions: ["americas"], source: "event" | "guardian-tags" | "gdacs" }; null = unlocated.
  location     Json?
  /// Order within the refresh (0 = first).
  position     Int
  /// When the refresh that produced the row ran; all rows of one refresh share it.
  fetchedAt    DateTime
  /// Guardian Open Platform terms: content may be held for at most 24 hours,
  /// so Guardian rows carry fetchedAt + 24 h and are deleted after that.
  /// GDELT and GDACS rows: fetchedAt + 72 h.
  expiresAt    DateTime?

  @@index([expiresAt])
}
