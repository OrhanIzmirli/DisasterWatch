# Copy to backend/.env. docker-compose.yml overrides NODE_ENV, PORT, DATABASE_URL
# and KAFKA_BROKER for the containers; the values below are the local defaults.

PORT=5000
# development: plain-http cookies on localhost and the dev JWT placeholder are
# tolerated. Use production for any deployment (Secure cookies, strict secret check).
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@disasterwatch_db:5432/disasterwatch

# CHANGE ME before any deployment. Dev-only placeholder (32+ characters) so a
# fresh clone starts; production refuses to start with a secret shorter than 32
# characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
JWT_EXPIRES_IN=1d
COOKIE_NAME=dw_session
# Comma-separated e-mails that get the admin role (case-insensitive). Everyone else is "user".
ADMIN_EMAILS=

# Kafka broker(s), comma-separated. Local docker-compose: the service name.
KAFKA_BROKER=dw-kafka:9092

# Managed Kafka (e.g. Aiven). Leave empty for the local plaintext broker.
# When username and password are both set, the client connects with SASL_SSL.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# plain | scram-sha-256 | scram-sha-512 (default: scram-sha-256)
KAFKA_SASL_MECHANISM=
# Optional CA certificate (PEM). Needed when the provider uses a private CA.
# Newlines can be written as \n to keep the value on one line.
KAFKA_SSL_CA=

# News fallback provider (optional). A Guardian Open Platform developer key
# (https://open-platform.theguardian.com/access/, non-commercial, 500 req/day).
# When unset the news job runs on GDELT plus the database cache only.
GUARDIAN_API_KEY=
# Per-request timeout for GDELT searches, milliseconds (default 8000).
GDELT_TIMEOUT_MS=

# GDACS impact levels (severity of wildfires and floods). Looked up per event on
# gdacs.org, cached for hours; a timeout or outage falls back to the EONET
# measurement. DISABLE_GDACS=1 switches the lookups off.
GDACS_TIMEOUT_MS=
DISABLE_GDACS=

# Browser origins allowed to call the API directly (comma-separated). The
# frontend's /api proxy is same-origin and needs no entry. Default when unset:
# the live frontend plus localhost:8080 / 5173 / 4173.
CORS_ORIGINS=

# Set to 1 to switch off a background job (both run unless NODE_ENV=test).
DISABLE_NEWS_JOB=
DISABLE_INGESTION=
